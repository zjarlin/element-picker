{
  "name": "@zjarlin/element-picker",
  "version": "0.1.0",
  "description": "浏览器元素拾取 → 源码定位：编译期把模板元素位置写进 DOM，运行期提供 Chrome 式拾取器与 Vue 组件链解析（无业务符号，可直接被任何 Vite + Vue 项目依赖）",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zjarlin/element-picker.git"
  },
  "homepage": "https://github.com/zjarlin/element-picker#readme",
  "bugs": {
    "url": "https://github.com/zjarlin/element-picker/issues"
  },
  "license": "MIT",
  "packageManager": "pnpm@11.7.0",
  "type": "module",
  "sideEffects": false,
  "keywords": [
    "element-picker",
    "source-locator",
    "vue",
    "vite",
    "devtools",
    "inspect-element"
  ],
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/cjs/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "peerDependencies": {
    "vite": ">=5",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "~5.9.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js",
      "require": "./dist/cjs/vite.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "require": "./dist/cjs/browser.js"
    },
    "./location": {
      "types": "./dist/location.d.ts",
      "import": "./dist/location.js",
      "require": "./dist/cjs/location.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.build.cjs.json && node scripts/finish-cjs.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "prepare": "npm run build"
  }
}
